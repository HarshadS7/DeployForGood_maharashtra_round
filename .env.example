# offline: deterministic local stand-ins (local default: forks and custom tasks work)
# recorded: cassette responses only, read-only demo (deployments); live: call the model provider
MODE=offline
DATA_DIR=data
LLM_BASE_URL=https://api.groq.com/openai/v1
AGENT_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=
# Local web browser API target. On Vercel set this to the public Render API URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000
